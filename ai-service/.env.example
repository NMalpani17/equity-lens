# Copy to .env and adjust. Never commit the real .env.
# All variables are prefixed with AI_SERVICE_.

AI_SERVICE_ENVIRONMENT=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=INFO

# Comma-separated CORS origins allowed to call this service (the API gateway).
AI_SERVICE_CORS_ORIGINS=http://localhost:3001

# --- Market data ---
# Finnhub is the primary quote provider (yfinance is the automatic fallback).
# Get a free key at https://finnhub.io/dashboard. Fill this in.
AI_SERVICE_FINNHUB_API_KEY=your-finnhub-api-key
AI_SERVICE_FINNHUB_BASE_URL=https://finnhub.io/api/v1
# Seconds a quote is cached before refetching.
AI_SERVICE_MARKET_CACHE_TTL_SECONDS=60
# Timeout (seconds) for outbound provider HTTP requests.
AI_SERVICE_MARKET_HTTP_TIMEOUT_SECONDS=5.0

# --- Database (Supabase Postgres) ---
# Same database as the API. Use the pooled (PgBouncer, port 6543) connection
# string from Supabase -> Project Settings -> Database. Tables are created by
# the API's Prisma migrations (npm --prefix api run prisma:migrate).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- RAG: earnings call transcripts ---
# Equibles transcript API key (eq_...). Free plan: 100 requests/day, resets 00:00 UTC.
# Create one at https://equibles.com/dashboard/apikeys
AI_SERVICE_EQUIBLES_API_KEY=your-equibles-api-key
# Gemini API key for dense embeddings: https://aistudio.google.com/apikey
AI_SERVICE_GEMINI_API_KEY=your-gemini-api-key
# Pinecone API key (sparse vectors, index, reranking): https://app.pinecone.io
AI_SERVICE_PINECONE_API_KEY=your-pinecone-api-key

# Optional tuning (defaults shown).
# AI_SERVICE_PINECONE_INDEX_NAME=equity-lens-transcripts
# AI_SERVICE_PINECONE_REGION=us-east-1
# AI_SERVICE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# AI_SERVICE_EMBEDDING_DIMENSION=768
# Texts embedded per minute (Gemini free tier counts each text as a request,
# limit 100/min). Raise on a paid tier; 0 disables the client-side limiter.
# AI_SERVICE_GEMINI_EMBED_TEXTS_PER_MINUTE=100
# Estimated tokens per minute, also the max tokens in one batch (free tier ~30k).
# AI_SERVICE_GEMINI_EMBED_TOKENS_PER_MINUTE=24000
# AI_SERVICE_RAG_QUARTERS=4
# AI_SERVICE_RAG_CANDIDATE_K=25
# AI_SERVICE_RAG_HYBRID_ALPHA=0.75
# New tickers ingested on demand per UTC day (protects the Equibles quota).
# AI_SERVICE_RAG_DAILY_INGESTION_CAP=8
# Indexed tickers whose newest call is older than this many days are checked
# for a newer call when searched (at most once per ticker per day).
# AI_SERVICE_RAG_FRESHNESS_DAYS=90
# Refresh jobs (newer call found) per UTC day; 0 turns refresh off.
# AI_SERVICE_RAG_DAILY_REFRESH_CAP=3

# --- Internal service auth ---
# Shared secret between the API gateway and this service (same value as
# AI_SERVICE_INTERNAL_TOKEN in api/.env). Required: every route except
# /health rejects requests without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_INTERNAL_TOKEN=change-me

# --- AI analyst chat ---
# Uses AI_SERVICE_GEMINI_API_KEY above. Model is "provider:model" (LangChain
# init_chat_model), so another provider can be swapped in via config.
# AI_SERVICE_CHAT_MODEL=google_genai:gemini-3.8-flash
# AI_SERVICE_CHAT_THINKING_LEVEL=low
# AI_SERVICE_CHAT_MAX_OUTPUT_TOKENS=2048
# AI_SERVICE_CHAT_MAX_MODEL_CALLS=6
# AI_SERVICE_CHAT_MAX_TOOL_CALLS=8
# AI_SERVICE_CHAT_MAX_MESSAGE_CHARS=2000
# Seconds search_transcripts waits for on-demand indexing within a turn.
# AI_SERVICE_CHAT_INDEX_WAIT_SECONDS=45

# --- Research reports (multi-agent) ---
# Two researchers in parallel, then a writer (no tools).
# AI_SERVICE_REPORT_TRANSCRIPT_MODEL=google_genai:gemini-3.8-flash
# AI_SERVICE_REPORT_MARKET_MODEL=google_genai:gemini-3.5-flash-lite
# AI_SERVICE_REPORT_WRITER_MODEL=google_genai:gemini-3.8-flash
# AI_SERVICE_REPORT_THINKING_LEVEL=low
# Step limits per agent run.
# AI_SERVICE_REPORT_TRANSCRIPT_MAX_MODEL_CALLS=5
# AI_SERVICE_REPORT_TRANSCRIPT_MAX_TOOL_CALLS=2
# AI_SERVICE_REPORT_MARKET_MAX_MODEL_CALLS=3
# AI_SERVICE_REPORT_MARKET_MAX_TOOL_CALLS=3
# Whole run bound, and when a generation lock is assumed dead (keep equal to
# the api's REPORT_STALE_GENERATION_MINUTES).
# AI_SERVICE_REPORT_TIMEOUT_SECONDS=240
# AI_SERVICE_REPORT_LOCK_STALE_MINUTES=10

# --- Tracing (Langfuse, optional) ---
# Leave both keys empty to disable tracing. Keys: Langfuse -> Project Settings
# -> API Keys. Payloads are masked and user ids hashed before export.
AI_SERVICE_LANGFUSE_PUBLIC_KEY=
AI_SERVICE_LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US) or self-hosted.
AI_SERVICE_LANGFUSE_BASE_URL=https://cloud.langfuse.com
# HMAC key for hashing user ids in traces (any random string; keep it stable).
AI_SERVICE_TRACE_USER_SALT=
# Optional tuning (defaults shown).
# AI_SERVICE_LANGFUSE_SAMPLE_RATE=1.0
# AI_SERVICE_LANGFUSE_TIMEOUT_SECONDS=2

# --- Shutdown (Cloud Run sends SIGTERM ~10s before killing the instance) ---
# Seconds to wait for background ingestion to stop (an interrupted job is
# reclaimed later), then for pending traces to flush.
# AI_SERVICE_SHUTDOWN_INGESTION_TIMEOUT_SECONDS=3
# AI_SERVICE_SHUTDOWN_TRACING_TIMEOUT_SECONDS=2
