# Copy to .env and adjust. Never commit the real .env.
# All variables are prefixed with AI_SERVICE_.

AI_SERVICE_ENVIRONMENT=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=INFO

# Comma-separated CORS origins allowed to call this service (the API gateway).
AI_SERVICE_CORS_ORIGINS=http://localhost:3001

# --- Market data ---
# Finnhub is the primary quote provider (yfinance is the automatic fallback).
# Get a free key at https://finnhub.io/dashboard. Fill this in.
AI_SERVICE_FINNHUB_API_KEY=your-finnhub-api-key
AI_SERVICE_FINNHUB_BASE_URL=https://finnhub.io/api/v1
# Seconds a quote is cached before refetching.
AI_SERVICE_MARKET_CACHE_TTL_SECONDS=60
# Timeout (seconds) for outbound provider HTTP requests.
AI_SERVICE_MARKET_HTTP_TIMEOUT_SECONDS=5.0

# --- Database (Supabase Postgres) ---
# Same database as the API. Use the pooled (PgBouncer, port 6543) connection
# string from Supabase -> Project Settings -> Database. Tables are created by
# the API's Prisma migrations (npm --prefix api run prisma:migrate).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- RAG: earnings call transcripts ---
# Equibles transcript API key (eq_...). Free plan: 100 requests/day, resets 00:00 UTC.
# Create one at https://equibles.com/dashboard/apikeys
AI_SERVICE_EQUIBLES_API_KEY=your-equibles-api-key
# Gemini API key for dense embeddings: https://aistudio.google.com/apikey
AI_SERVICE_GEMINI_API_KEY=your-gemini-api-key
# Pinecone API key (sparse vectors, index, reranking): https://app.pinecone.io
AI_SERVICE_PINECONE_API_KEY=your-pinecone-api-key

# Optional tuning (defaults shown).
# AI_SERVICE_PINECONE_INDEX_NAME=equity-lens-transcripts
# AI_SERVICE_PINECONE_REGION=us-east-1
# AI_SERVICE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# AI_SERVICE_EMBEDDING_DIMENSION=768
# AI_SERVICE_RAG_QUARTERS=4
# AI_SERVICE_RAG_CANDIDATE_K=25
# AI_SERVICE_RAG_HYBRID_ALPHA=0.75
# New tickers ingested on demand per UTC day (protects the Equibles quota).
# AI_SERVICE_RAG_DAILY_INGESTION_CAP=8

# LLM provider keys go here later. Never commit real keys.
# AI_SERVICE_ANTHROPIC_API_KEY=
