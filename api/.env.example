# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Downstream AI service (FastAPI).
AI_SERVICE_URL=http://localhost:8000
# Shared secret for gateway -> ai-service calls (same value as
# AI_SERVICE_INTERNAL_TOKEN in ai-service/.env). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_INTERNAL_TOKEN=change-me

# --- AI analyst chat limits ---
# User messages per UTC day: signed-in users, demo (anonymous) users, and all
# users combined (protects the Gemini budget).
# CHAT_DAILY_LIMIT=20
# CHAT_DAILY_LIMIT_ANON=5
# CHAT_GLOBAL_DAILY_LIMIT=60
# CHAT_MAX_MESSAGE_CHARS=2000
# Conversation context sent to the model (final answers only).
# CHAT_HISTORY_MESSAGES=6
# CHAT_HISTORY_TOKENS=3000

# Origin allowed by CORS (the Vite client dev server).
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase PostgreSQL (Prisma) ---------------------------------------
# DATABASE_URL: pooled connection (PgBouncer, port 6543) used by the app.
# DIRECT_URL:   direct connection (port 5432) used by Prisma for migrations.
# Copy both from Supabase → Project Settings → Database → Connection string.
# Keep ?pgbouncer=true on the pooled URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ------------------------------------------------------
# Project URL (Supabase → Project Settings → Data API → Project URL). Used to
# verify user JWTs against the project's JWKS on every holdings/portfolio route.
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key (Supabase → Project Settings → API Keys → service_role).
# SERVER-SIDE ONLY — grants admin access (used to delete a user's auth account).
# Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
