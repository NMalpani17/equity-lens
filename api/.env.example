# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Downstream AI service (FastAPI).
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent on every gateway -> ai-service call (same value as
# AI_SERVICE_INTERNAL_TOKEN in ai-service/.env). Required for quotes,
# transcript search and chat. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_INTERNAL_TOKEN=change-me
# Production only (ai-service behind Cloud Run IAM): the ai-service URL, used as
# the audience of the Google ID token sent on every ai-service call. Leave
# empty locally: no ID token is fetched.
# AI_SERVICE_ID_TOKEN_AUDIENCE=https://equity-lens-ai-service-xxxxx.us-east4.run.app

# --- AI analyst chat limits ---
# User messages per UTC day: signed-in users, demo (anonymous) users, and all
# users combined (protects the Gemini budget).
# CHAT_DAILY_LIMIT=20
# CHAT_DAILY_LIMIT_ANON=5
# CHAT_GLOBAL_DAILY_LIMIT=60
# CHAT_MAX_MESSAGE_CHARS=2000
# Conversation context sent to the model (final answers only).
# CHAT_HISTORY_MESSAGES=6
# CHAT_HISTORY_TOKENS=3000
# How long to wait for the ai-service to start answering a turn (covers a
# ~15s cold start), and how often to send an SSE keepalive comment meanwhile.
# CHAT_CONNECT_TIMEOUT_MS=30000
# CHAT_KEEPALIVE_MS=10000

# Origins allowed by CORS: comma-separated, exact matches (no wildcards).
# Production: the Vercel URL(s), e.g. https://equity-lens.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase PostgreSQL (Prisma) ---------------------------------------
# DATABASE_URL: pooled connection (PgBouncer, port 6543) used by the app.
# DIRECT_URL:   direct connection (port 5432) used by Prisma for migrations.
# Copy both from Supabase → Project Settings → Database → Connection string.
# Keep ?pgbouncer=true on the pooled URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ------------------------------------------------------
# Project URL (Supabase → Project Settings → Data API → Project URL). Used to
# verify user JWTs against the project's JWKS on every holdings/portfolio route.
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key (Supabase → Project Settings → API Keys → service_role).
# SERVER-SIDE ONLY — grants admin access (used to delete a user's auth account).
# Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
