# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Downstream AI service (FastAPI).
AI_SERVICE_URL=http://localhost:8000

# Origin allowed by CORS (the Vite client dev server).
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase PostgreSQL (Prisma) ---------------------------------------
# DATABASE_URL: pooled connection (PgBouncer, port 6543) used by the app.
# DIRECT_URL:   direct connection (port 5432) used by Prisma for migrations.
# Copy both from Supabase → Project Settings → Database → Connection string.
# Keep ?pgbouncer=true on the pooled URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ------------------------------------------------------
# Project URL (Supabase → Project Settings → Data API → Project URL). Used to
# verify user JWTs against the project's JWKS on every holdings/portfolio route.
SUPABASE_URL=https://<project-ref>.supabase.co

# Demo account user id (the `sub`/UUID of the shared demo auth user). Used by
# `npm run db:seed` to attach sample holdings to the demo account. Find it in
# Supabase → Authentication → Users after creating the demo user.
DEMO_USER_ID=00000000-0000-0000-0000-000000000000
