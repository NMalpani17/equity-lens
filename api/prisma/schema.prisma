// Prisma schema for the Equity Lens API.
//
// Uses Supabase PostgreSQL with two connection strings:
//   - DATABASE_URL: pooled (PgBouncer) connection for the running app.
//   - DIRECT_URL:   direct connection used by Prisma for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A single equity holding (one buy lot) in a portfolio. Multiple lots may
/// share a ticker; the portfolio summary groups them into one position.
model Holding {
  id        String    @id @default(uuid())
  /// Supabase Auth user id (the JWT `sub`) that owns this lot. Every query is
  /// scoped to this so users only ever see their own holdings.
  userId    String    @map("user_id") @db.Uuid
  ticker    String
  /// Number of shares held. Fractional shares supported.
  shares    Decimal   @db.Decimal(20, 8)
  /// Price paid per share at purchase, in USD.
  buyPrice  Decimal   @map("buy_price") @db.Decimal(20, 8)
  /// Optional date the lot was purchased.
  purchaseDate DateTime? @map("purchase_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("holdings")
}

/// Marks that a user has had the demo portfolio seeded. Ensures anonymous
/// "Try demo" users are seeded exactly once, so deleting every holding does not
/// trigger a re-seed on the next load.
model DemoSeed {
  userId   String   @id @map("user_id") @db.Uuid
  seededAt DateTime @default(now()) @map("seeded_at")

  @@map("demo_seeds")
}

// ---------------------------------------------------------------------------
// RAG over earnings call transcripts.
//
// These tables are owned by Prisma (schema + migrations) but read and written
// by the ai-service via psycopg. Keep column names in sync with
// ai-service/app/services/rag/repository.py.
// ---------------------------------------------------------------------------

/// Lifecycle of a ticker in the transcript search index.
enum RagTickerStatus {
  /// An ingestion job is queued or running.
  indexing
  /// Transcripts are embedded and searchable.
  indexed
  /// The last ingestion attempt failed; a later search may retry it.
  failed
  /// Equibles has no transcripts for this ticker; never retried automatically.
  unavailable

  @@map("rag_ticker_status")
}

/// Lifecycle of a single ingestion job.
enum RagJobStatus {
  queued
  running
  succeeded
  failed

  @@map("rag_job_status")
}

/// One row per ticker that has been (or is being) ingested into Pinecone.
model RagTicker {
  ticker             String          @id
  companyName        String?         @map("company_name")
  status             RagTickerStatus
  /// Number of chunks upserted for this ticker on the last successful run.
  chunkCount         Int             @default(0) @map("chunk_count")
  /// Quarters indexed, e.g. ["FY2025Q3", "FY2025Q4"].
  quarters           Json            @default("[]")
  lastError          String?         @map("last_error")
  /// The most recent ingestion job for this ticker.
  lastJobId          String?         @map("last_job_id") @db.Uuid
  indexedAt          DateTime?       @map("indexed_at")
  /// Date of the newest indexed earnings call (drives the freshness check).
  latestCallDate     DateTime?       @map("latest_call_date") @db.Date
  /// Last time Equibles was asked for a newer call (at most once per UTC day).
  freshnessCheckedAt DateTime?       @map("freshness_checked_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("rag_tickers")
}

/// A background ingestion run for one ticker.
model RagIngestionJob {
  id         String       @id @default(uuid()) @db.Uuid
  ticker     String
  status     RagJobStatus
  /// What started the job: "on_demand" (a search), "refresh" (a newer call
  /// for an indexed ticker) or "seed" (the CLI script).
  trigger    String
  chunkCount Int          @default(0) @map("chunk_count")
  error      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  startedAt  DateTime?    @map("started_at")
  finishedAt DateTime?    @map("finished_at")

  @@index([ticker, createdAt])
  @@map("rag_ingestion_jobs")
}

/// Per-UTC-day counters of new-ticker ingestions and freshness refreshes,
/// enforcing the daily caps that keep us inside Equibles' request quota (which
/// resets at 00:00 UTC).
model RagDailyUsage {
  day                 DateTime @id @db.Date
  newTickerIngestions Int      @default(0) @map("new_ticker_ingestions")
  refreshIngestions   Int      @default(0) @map("refresh_ingestions")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("rag_daily_usage")
}

/// Raw Equibles transcript responses (all speaker-turn pages merged), cached
/// so re-runs and re-indexing never spend API quota.
model RagTranscript {
  ticker        String
  fiscalYear    Int       @map("fiscal_year")
  fiscalQuarter Int       @map("fiscal_quarter")
  eventTitle    String?   @map("event_title")
  callDate      DateTime? @map("call_date")
  payload       Json
  fetchedAt     DateTime  @default(now()) @map("fetched_at")

  @@id([ticker, fiscalYear, fiscalQuarter])
  @@map("rag_transcripts")
}

// ---------------------------------------------------------------------------
// AI analyst chat. Written by the API gateway; the ai-service is stateless.
// ---------------------------------------------------------------------------

enum ChatRole {
  user
  assistant

  @@map("chat_role")
}

/// Lifecycle of a chat message. Assistant messages start as `streaming` and
/// end in one of the other states.
enum ChatMessageStatus {
  streaming
  complete
  truncated
  blocked
  empty
  refused
  interrupted
  error

  @@map("chat_message_status")
}

/// A user's chat conversation.
model ChatConversation {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  title               String        @default("New chat")
  /// Set while a turn is streaming, so a second concurrent turn gets a 409.
  activeTurnId        String?       @map("active_turn_id") @db.Uuid
  activeTurnStartedAt DateTime?     @map("active_turn_started_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")
  messages            ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

/// One message in a conversation, with the citations and tool calls behind it.
model ChatMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Owner (denormalized from the conversation) for per-user daily caps.
  userId         String            @map("user_id") @db.Uuid
  role           ChatRole
  content        String            @default("")
  status         ChatMessageStatus @default(complete)
  citations      Json              @default("[]")
  toolCalls      Json              @default("[]") @map("tool_calls")
  /// Inline charts built from tool results (price history, allocation).
  charts         Json              @default("[]")
  errorCode      String?           @map("error_code")
  inputTokens    Int?              @map("input_tokens")
  outputTokens   Int?              @map("output_tokens")
  model          String?
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([userId, role, createdAt])
  @@index([role, createdAt])
  @@map("chat_messages")
}

/// One row per chat turn (a sent message or a retry), so daily caps count
/// every model run, including retries that don't add a user message.
model ChatUsageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// "message" (a new question) or "retry" (regenerating a stopped/failed reply).
  kind      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("chat_usage_events")
}
