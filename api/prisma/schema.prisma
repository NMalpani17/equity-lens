// Prisma schema for the Equity Lens API.
//
// Uses Supabase PostgreSQL with two connection strings:
//   - DATABASE_URL: pooled (PgBouncer) connection for the running app.
//   - DIRECT_URL:   direct connection used by Prisma for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A single equity holding (one buy lot) in a portfolio. Multiple lots may
/// share a ticker; the portfolio summary groups them into one position.
model Holding {
  id        String    @id @default(uuid())
  /// Supabase Auth user id (the JWT `sub`) that owns this lot. Every query is
  /// scoped to this so users only ever see their own holdings.
  userId    String    @map("user_id") @db.Uuid
  ticker    String
  /// Number of shares held. Fractional shares supported.
  shares    Decimal   @db.Decimal(20, 8)
  /// Price paid per share at purchase, in USD.
  buyPrice  Decimal   @map("buy_price") @db.Decimal(20, 8)
  /// Optional date the lot was purchased.
  purchaseDate DateTime? @map("purchase_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("holdings")
}

/// Marks that a user has had the demo portfolio seeded. Ensures anonymous
/// "Try demo" users are seeded exactly once, so deleting every holding does not
/// trigger a re-seed on the next load.
model DemoSeed {
  userId            String    @id @map("user_id") @db.Uuid
  seededAt          DateTime  @default(now()) @map("seeded_at")
  /// When the sample watchlist was seeded; null until then (including demo
  /// users seeded before the watchlist existed).
  watchlistSeededAt DateTime? @map("watchlist_seeded_at")

  @@map("demo_seeds")
}

/// A company the user is considering (not owned). Never part of portfolio
/// totals, performance or sectors.
model WatchlistItem {
  id           String    @id @default(uuid()) @db.Uuid
  /// Supabase Auth user id; every query is scoped to it.
  userId       String    @map("user_id") @db.Uuid
  ticker       String
  /// Price when added, for "change since added"; null until a quote is
  /// available (then filled once, with `addedPriceAt`).
  addedPrice   Decimal?  @map("added_price") @db.Decimal(20, 8)
  addedPriceAt DateTime? @map("added_price_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([userId, ticker])
  @@index([userId, createdAt])
  @@map("watchlist_items")
}

// ---------------------------------------------------------------------------
// RAG over earnings call transcripts.
//
// These tables are owned by Prisma (schema + migrations) but read and written
// by the ai-service via psycopg. Keep column names in sync with
// ai-service/app/services/rag/repository.py.
// ---------------------------------------------------------------------------

/// Lifecycle of a ticker in the transcript search index.
enum RagTickerStatus {
  /// An ingestion job is queued or running.
  indexing
  /// Transcripts are embedded and searchable.
  indexed
  /// The last ingestion attempt failed; a later search may retry it.
  failed
  /// Equibles has no transcripts for this ticker; never retried automatically.
  unavailable

  @@map("rag_ticker_status")
}

/// Lifecycle of a single ingestion job.
enum RagJobStatus {
  queued
  running
  succeeded
  failed

  @@map("rag_job_status")
}

/// One row per ticker that has been (or is being) ingested into Pinecone.
model RagTicker {
  ticker             String          @id
  companyName        String?         @map("company_name")
  status             RagTickerStatus
  /// Number of chunks upserted for this ticker on the last successful run.
  chunkCount         Int             @default(0) @map("chunk_count")
  /// Quarters indexed, e.g. ["FY2025Q3", "FY2025Q4"].
  quarters           Json            @default("[]")
  lastError          String?         @map("last_error")
  /// The most recent ingestion job for this ticker.
  lastJobId          String?         @map("last_job_id") @db.Uuid
  indexedAt          DateTime?       @map("indexed_at")
  /// Date of the newest indexed earnings call (drives the freshness check).
  latestCallDate     DateTime?       @map("latest_call_date") @db.Date
  /// Last time Equibles was asked for a newer call (at most once per UTC day).
  freshnessCheckedAt DateTime?       @map("freshness_checked_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("rag_tickers")
}

/// A background ingestion run for one ticker.
model RagIngestionJob {
  id         String       @id @default(uuid()) @db.Uuid
  ticker     String
  status     RagJobStatus
  /// What started the job: "on_demand" (a search), "refresh" (a newer call
  /// for an indexed ticker), "seed" (the CLI script) or "eval_plain" (the
  /// eval namespace build; not linked from rag_tickers).
  trigger    String
  chunkCount Int          @default(0) @map("chunk_count")
  error      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  startedAt  DateTime?    @map("started_at")
  finishedAt DateTime?    @map("finished_at")

  @@index([ticker, createdAt])
  @@map("rag_ingestion_jobs")
}

/// Per-UTC-day counters of new-ticker ingestions and freshness refreshes,
/// enforcing the daily caps that keep us inside Equibles' request quota (which
/// resets at 00:00 UTC).
model RagDailyUsage {
  day                 DateTime @id @db.Date
  newTickerIngestions Int      @default(0) @map("new_ticker_ingestions")
  refreshIngestions   Int      @default(0) @map("refresh_ingestions")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("rag_daily_usage")
}

/// Raw Equibles transcript responses (all speaker-turn pages merged), cached
/// so re-runs and re-indexing never spend API quota.
model RagTranscript {
  ticker        String
  fiscalYear    Int       @map("fiscal_year")
  fiscalQuarter Int       @map("fiscal_quarter")
  eventTitle    String?   @map("event_title")
  callDate      DateTime? @map("call_date")
  payload       Json
  fetchedAt     DateTime  @default(now()) @map("fetched_at")

  @@id([ticker, fiscalYear, fiscalQuarter])
  @@map("rag_transcripts")
}

// ---------------------------------------------------------------------------
// AI analyst chat. Written by the API gateway; the ai-service is stateless.
// ---------------------------------------------------------------------------

enum ChatRole {
  user
  assistant

  @@map("chat_role")
}

/// Lifecycle of a chat message. Assistant messages start as `streaming` and
/// end in one of the other states.
enum ChatMessageStatus {
  streaming
  complete
  truncated
  blocked
  empty
  refused
  interrupted
  error

  @@map("chat_message_status")
}

/// A user's chat conversation.
model ChatConversation {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  title               String        @default("New chat")
  /// Set while a turn is streaming, so a second concurrent turn gets a 409.
  activeTurnId        String?       @map("active_turn_id") @db.Uuid
  activeTurnStartedAt DateTime?     @map("active_turn_started_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")
  messages            ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

/// One message in a conversation, with the citations and tool calls behind it.
model ChatMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Owner (denormalized from the conversation) for per-user daily caps.
  userId         String            @map("user_id") @db.Uuid
  role           ChatRole
  content        String            @default("")
  status         ChatMessageStatus @default(complete)
  citations      Json              @default("[]")
  toolCalls      Json              @default("[]") @map("tool_calls")
  /// Inline charts built from tool results (price history, allocation).
  charts         Json              @default("[]")
  errorCode      String?           @map("error_code")
  inputTokens    Int?              @map("input_tokens")
  outputTokens   Int?              @map("output_tokens")
  model          String?
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([userId, role, createdAt])
  @@index([role, createdAt])
  @@map("chat_messages")
}

/// One row per model run (a chat turn, a retry, or a research report), so
/// daily caps count every run, including retries that don't add a message.
model ChatUsageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// "message" (a new question), "retry" (regenerating a stopped/failed
  /// reply) or "report" (generating a research report).
  kind      String
  /// Units counted against the global daily cap (a report costs about three
  /// chat turns, so it weighs 3).
  weight    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("chat_usage_events")
}

// ---------------------------------------------------------------------------
// Market data cache. Shared across users (no user data in it). Owned by
// Prisma, read and written by the ai-service via psycopg
// (ai-service/app/services/market_data/repository.py, symbols.py and
// earnings.py); the api reads market_symbols for names. Keep column names in
// sync.
// ---------------------------------------------------------------------------

/// One split-adjusted daily close (price return, no dividends) per ticker and
/// trading day. Only completed sessions are stored.
model MarketDailyClose {
  ticker String
  date   DateTime @db.Date
  close  Decimal  @db.Decimal(20, 6)

  @@id([ticker, date])
  @@map("market_daily_closes")
}

/// What `market_daily_closes` holds for a ticker, so a request only fetches
/// the missing range.
model MarketHistoryCoverage {
  ticker         String   @id
  /// Earliest date the cached closes cover (the earliest start asked for).
  coveredFrom    DateTime @map("covered_from") @db.Date
  /// Last completed trading session the cache was filled through.
  fetchedThrough DateTime @map("fetched_through") @db.Date
  /// "ok", or "no_history" when the provider had no closes (retried daily).
  status         String
  fetchedAt      DateTime @map("fetched_at")

  @@map("market_history_coverage")
}

/// Company profile used for sector allocation, refreshed after 30 days.
model CompanyProfile {
  ticker    String   @id
  name      String?
  /// Normalized sector (one of 11 GICS-style sectors, or "Funds"); null when
  /// unknown, which the portfolio shows as "Other".
  sector    String?
  /// The provider's own industry or sector label, before normalizing.
  industry  String?
  /// "finnhub", "yfinance", or "none" when neither knew the ticker.
  source    String
  fetchedAt DateTime @map("fetched_at")

  @@map("company_profiles")
}

/// One US symbol from Finnhub's list (common stocks, ETFs and ADRs), for
/// company search. The whole list is replaced at most once a day. The trigram
/// indexes need pg_trgm (in the "extensions" schema).
model MarketSymbol {
  ticker     String   @id
  /// Display name ("Microsoft Corp"), cleaned from `nameRaw`.
  name       String
  /// Finnhub's description as given ("MICROSOFT CORP").
  nameRaw    String   @map("name_raw")
  /// Lowercased name with punctuation collapsed, for matching.
  searchName String   @map("search_name")
  /// "stock", "etf" or "adr".
  type       String
  /// Market identifier code, e.g. "XNAS"; "OOTC" is over the counter.
  exchange   String?
  updatedAt  DateTime @map("updated_at")

  @@index([ticker(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("market_symbols")
}

/// A scheduled earnings report from Finnhub's calendar, for the next 60 days.
model MarketEarnings {
  ticker          String
  date            DateTime @db.Date
  /// "bmo" (before market open), "amc" (after market close), or null.
  hour            String?
  fiscalYear      Int?     @map("fiscal_year")
  fiscalQuarter   Int?     @map("fiscal_quarter")
  epsEstimate     Decimal? @map("eps_estimate") @db.Decimal(20, 6)
  revenueEstimate Decimal? @map("revenue_estimate") @db.Decimal(24, 2)
  fetchedAt       DateTime @map("fetched_at")

  @@id([ticker, date])
  @@index([date])
  @@map("market_earnings")
}

/// When a shared dataset ("us_symbols", "earnings_calendar") was last
/// refreshed, and the lease that lets only one refresh run at a time.
model MarketRefreshState {
  dataset         String    @id
  refreshedAt     DateTime? @map("refreshed_at")
  /// Last attempt, successful or not (failures back off from it).
  attemptedAt     DateTime? @map("attempted_at")
  /// Set while a refresh runs; a lease older than the stale window may be
  /// re-claimed.
  refreshingSince DateTime? @map("refreshing_since")
  refreshId       String?   @map("refresh_id") @db.Uuid
  rowCount        Int       @default(0) @map("row_count")
  coveredFrom     DateTime? @map("covered_from") @db.Date
  coveredTo       DateTime? @map("covered_to") @db.Date
  lastError       String?   @map("last_error")

  @@map("market_refresh_state")
}

// ---------------------------------------------------------------------------
// Research reports. Shared across users (no user data in them), keyed by
// ticker + the latest indexed quarter. Owned by Prisma, written by the
// ai-service via psycopg (ai-service/app/services/report/repository.py) and
// read by the API gateway. Keep column names in sync.
// ---------------------------------------------------------------------------

/// One multi-agent research report per ticker and fiscal quarter (the newest
/// indexed earnings call when it was generated). Regenerating overwrites it.
model ResearchReport {
  id              String    @id @default(uuid()) @db.Uuid
  ticker          String
  fiscalYear      Int       @map("fiscal_year")
  fiscalQuarter   Int       @map("fiscal_quarter")
  companyName     String?   @map("company_name")
  /// The report (sections, citations, chart, "as of" dates); null until the
  /// first generation for this quarter succeeds.
  content         Json?
  generatedAt     DateTime? @map("generated_at")
  /// Set while a generation runs (one at a time per ticker and quarter); a
  /// lock older than the stale window may be re-claimed.
  generatingSince DateTime? @map("generating_since")
  /// Identifies the generation holding the lock.
  generationId    String?   @map("generation_id") @db.Uuid
  /// Langfuse trace of the generation that produced `content`.
  traceId         String?   @map("trace_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([ticker, fiscalYear, fiscalQuarter])
  @@index([ticker, generatedAt])
  @@map("research_reports")
}
