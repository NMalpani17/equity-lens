{
  "name": "equity-lens",
  "version": "0.1.0",
  "private": true,
  "description": "Equity Lens — AI investment research platform (monorepo root)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n ai,api,client -c magenta,cyan,green \"npm:dev:ai\" \"npm:dev:api\" \"npm:dev:client\"",
    "dev:ai": "cd ai-service && .venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "dev:api": "npm --prefix api run dev",
    "dev:client": "npm --prefix client run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0"
  }
}
