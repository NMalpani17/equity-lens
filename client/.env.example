# Copy to .env and adjust. Never commit the real .env.
# Vite only exposes variables prefixed with VITE_ to the client.

# Base URL of the Express API gateway.
VITE_API_URL=http://localhost:3001

# --- Supabase Auth ------------------------------------------------------
# From Supabase → Project Settings → Data API (Project URL) and → API Keys
# (the "publishable"/anon key). The publishable key is safe to ship in the
# browser; never put the service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>

# --- Demo account -------------------------------------------------------
# Credentials of the shared demo user for the "Try demo" button. Create this
# user in Supabase → Authentication → Users, then seed its holdings with
# `npm run db:seed` in the api package (see api/.env DEMO_USER_ID).
VITE_DEMO_EMAIL=demo@equitylens.app
VITE_DEMO_PASSWORD=<demo-account-password>
